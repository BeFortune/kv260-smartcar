[Unit]
Description=KV260 car: download the pinned PL bit once per boot
# 等 PYNQ 平台服务就绪；没有这些服务时 After 不起作用，不会卡住
After=local-fs.target network.target pl-server.service
ConditionPathExists=/opt/kv260car/current/tools/car/pl_load.py

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=XILINX_XRT=/usr
Environment=PATH=/usr/local/share/pynq-venv/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/local/share/pynq-venv/bin/python3 /opt/kv260car/current/tools/car/pl_load.py --bit /opt/kv260car/current/tools/car/models/conv_front_int8_20261021.bit
# 失败不自动重试（不反复编程 PL）。car-main 只认本次开机的标记，没有标记就一直等、什么都不碰；
# 查原因后用 `carctl pl` 手动重跑。
SuccessExitStatus=0
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
