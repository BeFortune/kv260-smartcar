# === pynq_ffn .gitignore ===
# 原则：artifacts/ 与 docs/ 是本仓库的证据链与结论，全部入库不忽略；
# 只忽略缓存、临时环境、编辑器状态和可再生成的构建产物。证据日志
# （如 hls/build/amd_20261014/、artifacts/vivado_*/* 下的 *.log/*.rpt）
# 是文档引用的证据内容，不要全局忽略 *.log。

# --- Python ---
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
.venv/
venv/
*.egg-info/

# --- 编辑器 / IDE 工作区状态（会话数据，不入库） ---
_ide/
.vscode/
.idea/

# --- 可再生成的 Windows 主机构建产物（hls/README.md 有重编译方法） ---
hls/build/*.exe
hls/build/*.dll

# --- AMD/Vivado 工具临时文件 ---
.vitisWorkspace.json
xil_*.log
vivado*.jou
*.str

# --- 操作系统杂项 ---
.DS_Store
Thumbs.db
desktop.ini

# --- ZCode 会话数据 ---
.zcode/
